{
  "builds": [
    {
      "env": {
        "DATABASE_URL": "file:./prisma/dev.db"
      }
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "server/main.ts",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/trpc/(.*)",
      "destination": "/api"
    }
  ]
}
