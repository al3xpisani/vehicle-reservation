{
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "server/main.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server/main.ts"
    }
  ],
  "rewrites": [
    {
      "source": "/trpc/(.*)",
      "destination": "/api"
    }
  ]
}
